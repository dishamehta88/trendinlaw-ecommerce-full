# Copy this file to server/.env and fill in real values. NEVER commit .env.
PORT=5000

# REQUIRED. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Optional: comma-separated list of allowed frontend origins in production.
# Leave empty to allow any origin (development only).
# CORS_ORIGINS=https://yourdomain.com
